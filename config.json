{
  "botName": "InstaBOT",
  "prefix": "#",
  "language": "en",
  "adminBot": ["33790118865"],
  "nickNameOnStart": "Z eyphex bot 😗",

  "env": {
    "token": "",
    "url": ""
  },

  "server": {
    "url": "",
    "token": "",
    "timeout": 60000
  },

  "account": {
    "proxy": null,
    "userAgent": null
  },

  "music": {
    "enable": true,
    "apiUrl": "",
    "apiToken": ""
  },

  "antiInbox": false,
  "noPrefix": false,

  "welcome": {
    "enable": true,
    "message": "Welcome %1 to %2! 👋",
    "threadIDs": [],
    "selfMessage": "Thanks for inviting me to %2 💋. Type {prefix}help to see all available commands."
  },

  "leave": {
    "enable": true,
    "message": "%1 left %2. 👋",
    "threadIDs": []
  },

  "adminOnly": {
    "enable": false,
    "ignoreCommands": []
  },

  "whiteList": {
    "enable": false,
    "userIDs": [],
    "threadIDs": []
  },

  "hideNotiMessage": {
    "commandNotFound": false,
    "adminOnly": false,
    "userBanned": false,
    "needRoleToUseCommand": false
  },

  "cooldown": {
    "default": 1
  },

  "selfListen": true,
  "listenEvents": true,
  "autoMarkRead": false,
  "autoMarkDelivery": true,
  "autoReconnect": true,
  "restartListenInterval": 3600000,

  "logEvents": {
    "disableAll": false,
    "message": true,
    "message_reply": true,
    "message_reaction": true,
    "message_unsend": true,
    "read_receipt": false,
    "typ": false
  },

  "onlineStatus": {
    "enable": true,
    "file": "data/online-status.jsonl",
    "interval": 60000
  },

  "database": {
    "dir": "data",
    "autoRefreshThreadInfo": true
  }
}
